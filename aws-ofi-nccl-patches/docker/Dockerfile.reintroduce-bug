# Dockerfile.reintroduce-bug
#
# Builds aws-ofi-nccl v1.17.2 with the deadlock bug REINTRODUCED
# This is for scientific testing to prove PR #968 fix was necessary
#
# The patch changes ONE LINE in the error handler:
#   dereg_mr_no_lock(ret_handle)  →  this->dereg_mr(ret_handle)
#
# This causes deadlock when fi_mr_regattr() fails because:
#   1. reg_mr() holds mr_cache->lock
#   2. fi_mr_regattr() fails
#   3. Error path calls dereg_mr() which tries to acquire mr_cache->lock
#   4. DEADLOCK - waiting for lock we already hold
#
# Build:
#   docker build -f Dockerfile.reintroduce-bug -t deadlock-test:v1.17.2-with-bug .
#
# Expected behavior:
#   Under MR registration errors → DEADLOCK
#   (Compare with v1.17.2 without patch → graceful error handling)

ARG BASE_IMAGE=058264135704.dkr.ecr.us-east-2.amazonaws.com/deadlock-test:latest
FROM ${BASE_IMAGE}

# Copy the patch and test files
COPY reintroduce-deadlock-bug.patch /tmp/
COPY moe_stress_test.py rdma_stress_test.py /workspace/

# Build aws-ofi-nccl v1.17.2 with bug reintroduced
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential autoconf automake libtool git && \
    rm -rf /var/lib/apt/lists/* && \
    \
    # Clone v1.17.2
    cd /tmp && \
    git clone --depth 1 --branch v1.17.2 https://github.com/aws/aws-ofi-nccl.git && \
    cd aws-ofi-nccl && \
    \
    # Reintroduce the deadlock bug by changing dereg_mr_no_lock to dereg_mr
    # This is the ONE LINE that causes deadlock when MR registration fails
    echo "=== Reintroducing deadlock bug ===" && \
    sed -i 's/(void) dereg_mr_no_lock(ret_handle);/(void) this->dereg_mr(ret_handle); \/\/ BUG: causes deadlock/' src/nccl_ofi_rdma.cpp && \
    echo "=== Bug reintroduced ===" && \
    \
    # Show the modified line to confirm
    grep -n "BUG: causes deadlock" src/nccl_ofi_rdma.cpp && \
    \
    # Build
    ./autogen.sh && \
    ./configure \
        --with-libfabric=/opt/amazon/efa \
        --with-cuda=/usr/local/cuda \
        --enable-platform-aws \
        --prefix=/tmp/install && \
    make -j$(nproc) && \
    make install && \
    \
    # Install - backup and replace
    mkdir -p /opt/aws-ofi-nccl-backup && \
    cp /opt/amazon/aws-ofi-nccl/lib/libnccl-net.so /opt/aws-ofi-nccl-backup/ && \
    cp /opt/amazon/aws-ofi-nccl/lib/libnccl-ofi-tuner.so /opt/aws-ofi-nccl-backup/ 2>/dev/null || true && \
    cp /tmp/install/lib/libnccl-net.so /opt/amazon/aws-ofi-nccl/lib/ && \
    cp /tmp/install/lib/libnccl-ofi-tuner.so /opt/amazon/aws-ofi-nccl/lib/ 2>/dev/null || true && \
    \
    # Create marker
    echo "v1.17.2-with-deadlock-bug" > /opt/aws-ofi-nccl-version.txt && \
    \
    # Cleanup
    rm -rf /tmp/aws-ofi-nccl /tmp/install /tmp/reintroduce-deadlock-bug.patch && \
    \
    # Verify
    echo "=== Installed aws-ofi-nccl ===" && \
    strings /opt/amazon/aws-ofi-nccl/lib/libnccl-net.so | grep "aws-ofi-nccl" | head -1 && \
    cat /opt/aws-ofi-nccl-version.txt

WORKDIR /workspace

LABEL aws.ofi.nccl.version="v1.17.2-with-deadlock-bug" \
      test.type="deadlock-bug-reintroduced" \
      test.purpose="Prove PR #968 fix was necessary"
